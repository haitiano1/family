Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^api(?:/.*)?$ api.php [END]
RewriteRule ^access/?$ access.html [END]
RewriteRule ^healthz/?$ health.php [END]
<FilesMatch "(?i)(^\.|config\.|\.sqlite$|\.sql$|^family-backup-.*\.json$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
